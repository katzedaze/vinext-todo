    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "shadcn": "4.21.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-805ec1ff3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitest/coverage-v8": "5.0.3",
    "cf": "1.0.0-beta.12",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.0",
    "vitest": "5.0.3"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "test": "vitest run",
    "typecheck": "cf workers types && tsc --noEmit",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:local": "node scripts/d1-migrate.ts --local",
    "db:migrate:remote": "node scripts/d1-migrate.ts --remote",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  }
}
